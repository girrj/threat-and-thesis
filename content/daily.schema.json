{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://threat-and-thesis.local/daily.schema.json",
  "title": "Threat & Thesis daily ranking",
  "type": "object",
  "additionalProperties": false,
  "required": ["date", "generatedAt", "rankings"],
  "properties": {
    "date": { "type": "string", "format": "date" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "rankings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rank", "itemId", "previousRank", "status", "reason"],
        "properties": {
          "rank": { "type": "integer", "minimum": 1 },
          "itemId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$" },
          "previousRank": {
            "anyOf": [
              { "type": "integer", "minimum": 1 },
              { "type": "null" }
            ]
          },
          "status": { "enum": ["new", "up", "down", "same", "returning"] },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
